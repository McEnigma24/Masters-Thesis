#!/usr/bin/env bash
# Przezroczysty wrapper: wszystko idzie przez uv w kontenerze CUDA.
#
# Użycie (z katalogu magisterka/):
#   ./scripts/drun sync
#   ./scripts/drun run python -c "import torch; print(torch.cuda.is_available())"
#   ./scripts/drun verify
#
# GPU: automatycznie włączane gdy nvidia-container-toolkit działa.
# Wymuś CPU:  MAGISTERKA_GPU=0 ./scripts/drun sync
# Wymuś GPU:  MAGISTERKA_GPU=1 ./scripts/drun verify

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

COMPOSE=(docker compose -f docker-compose.yml)
GPU_OK=0

detect_gpu() {
  if [[ "${MAGISTERKA_GPU:-auto}" == "0" ]]; then
    return 1
  fi
  if [[ "${MAGISTERKA_GPU:-auto}" == "1" ]]; then
    return 0
  fi
  docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia
}

if detect_gpu; then
  COMPOSE+=(-f docker-compose.gpu.yml)
  GPU_OK=1
fi

run_dev() {
  "${COMPOSE[@]}" run --rm --service-ports dev "$@"
}

register_kernel() {
  run_dev uv run python -m ipykernel install --sys-prefix \
    --name magisterka-sionna \
    --display-name "Magisterka Sionna (CUDA / Docker)"
}

if [[ "${1:-}" == "sync" ]]; then
  shift
  docker compose -f docker-compose.yml run --rm --service-ports dev uv sync "$@"
  sync_rc=$?
  register_kernel
  exit $sync_rc
fi

if [[ "${1:-}" == "jupyter" ]]; then
  shift
  echo "Jupyter Lab: http://127.0.0.1:${JUPYTER_PORT:-8888}/  (bez tokena, tylko localhost)"
  register_kernel
  run_dev uv run jupyter lab \
    --ip=0.0.0.0 \
    --port=8888 \
    --no-browser \
    --allow-root \
    --ServerApp.token='' \
    --ServerApp.password='' \
    --ServerApp.disable_check_xsrf=True \
    --ServerApp.allow_origin='*' \
    --notebook-dir=/workspace/neural-receiver/notebooks \
    "$@"
  exit $?
fi

if [[ "${1:-}" == "lock" ]]; then
  shift
  exec docker compose -f docker-compose.yml run --rm --service-ports dev uv lock "$@"
fi

if [[ "${1:-}" == "verify" ]]; then
  if [[ "$GPU_OK" -ne 1 ]]; then
    echo "BŁĄD: brak GPU w Dockerze." >&2
    echo "Uruchom: sudo ./scripts/setup-wsl-host.sh" >&2
    echo "Sprawdź sterownik NVIDIA na Windows (WSL2 CUDA)." >&2
    exit 1
  fi
  run_dev uv run python docker/verify_env.py
  exit $?
fi

if [[ "$GPU_OK" -ne 1 ]]; then
  echo "[drun] GPU niedostępne — kontener startuje bez CUDA (MAGISTERKA_GPU=0)" >&2
fi

run_dev uv "$@"
